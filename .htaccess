# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/bvngzbpv/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/bvngzbpv/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ----------------------------------------------------------------------
# ToolWala AI - Apache / LiteSpeed Web Server Configuration
# ----------------------------------------------------------------------

# Disable directory listings
Options -Indexes

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# ----------------------------------------------------------------------
# 1. NODE.JS DEPLOYMENT (Phusion Passenger / cPanel Setup Node.js App)
# If cPanel does not automatically configure Passenger, uncomment these lines 
# and replace /home/username/public_html with your cPanel directory path:
# ----------------------------------------------------------------------
# PassengerAppRoot "/home/bvngzbpv/public_html"
# PassengerBaseURI "/"
# PassengerAppStartFile "server.js"
# PassengerEnabled on

# ----------------------------------------------------------------------
# 2. STATIC EXPORT ROUTING FALLBACKS
# If you choose to deploy static files (via output: 'export'), these rules
# resolve Clean URLs (e.g. /admin/login -> /admin/login/index.html) and prevent
# 404 errors when refreshing pages.
# ----------------------------------------------------------------------

# Redirect index.html to root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# Redirect /admin/index.html to /admin/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /admin/index\.html\ HTTP/
RewriteRule ^admin/index\.html$ /admin/ [R=301,L]

# Resolve clean html files: /about -> /about/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

# SPA fallback: Route all non-existent paths in /admin to the admin index shell
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/admin/index.html -f
RewriteRule ^admin/(.*)$ /admin/index.html [L]
