toolId=pdf-tools dbTranslation={"toolSlug":"pdf-tools","locale":"en","title":"PDF Tools","description":"Merge, split, compress, and convert PDF files easily and securely.","faq":[{"question":"Is my data safe?","answer":"100%. We use client-side libraries to process PDFs. This means your files never leave your computer's memory. We literally cannot see your documents."},{"question":"Can I merge password-protected files?","answer":"Currently, you must remove the password from a PDF before our tool can process and merge it with other documents."},{"question":"Is there a file size limit?","answer":"Since it runs in your browser, the limit depends on your computer's RAM. Most users can easily process files up to 100MB without any issues."},{"question":"Does it work on mobile?","answer":"Yes! Our PDF suite is fully responsive and works great on tablets and smartphones for quick on-the-go edits."}],"seoTitle":"Free PDF Tools – Merge, Split & Edit PDF Online","seoDescription":"Use free browser-based PDF utilities to merge, split, encrypt, or decrypt files securely."} lpFound=false lpTitle=undefined resolvedTitle=Free PDF Tools – Merge, Split & Edit PDF Online
