toolId=pan-card-resize dbTranslation={"toolSlug":"pan-card-resize","locale":"en","title":"PAN Card Resize","description":"Resize, crop, and format passport photos to official NSDL and UTIITSL PAN card specifications. Keep head spacing, check background rules, and stay under the 50KB limit.","faq":[{"question":"What is the photo size for PAN card applications?","answer":"The official photo size required by NSDL and UTIITSL portals is 3.5cm x 2.5cm, which translates to exactly 213 x 213 pixels (1:1 ratio) at 300 DPI."},{"question":"What background color is compliant for PAN card photos?","answer":"A white or light-colored plain background is strictly recommended for PAN card applications."},{"question":"Does it work on smartphones?","answer":"Yes. Our tool is optimized for mobile touch screens, including pinch gestures and drags."}],"seoTitle":"PAN Card Resize – Free Online Tool","seoDescription":"Format and resize passport photos to official NSDL/UTIITSL PAN card specifications."} lpFound=false lpTitle=undefined resolvedTitle=PAN Card Resize – Free Online Tool
