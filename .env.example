# Supabase (required for production)
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (for npm run db:setup)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Admin setup (for npm run db:setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!

# Site
NEXT_PUBLIC_SITE_URL=https://www.toolwala.co

# AI Providers (server-side only — never expose to client)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: contact form email
RESEND_API_KEY=
CONTACT_EMAIL=info@example.com

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=GT-M398RGTT

# ToolWala PDF Engine (iLovePDF-like server editor)
PDF_ENGINE_URL=http://127.0.0.1:8787

# Edit PDF iframe. Local Vite editor is port 5173.
# Production (set in Vercel, not committed): https://editor.toolwala.co
NEXT_PUBLIC_EDITOR_URL=http://localhost:5173
