{
  "name": "toolwala-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/generate-version.js && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:edit-pdf": "playwright test tests/edit-pdf",
    "test:visual:update": "UPDATE_EDIT_PDF_BASELINES=1 playwright test tests/edit-pdf",
    "fixtures:edit-pdf": "node scripts/generate-edit-pdf-fixtures.mjs",
    "pdf-engine:install": "python3 -m venv services/pdf-engine/.venv && services/pdf-engine/.venv/bin/pip install -r services/pdf-engine/requirements.txt",
    "pdf-engine": "services/pdf-engine/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787 --app-dir services/pdf-engine",
    "db:setup": "node scripts/setup-supabase.mjs",
    "db:seed-blogs": "node scripts/seed-blogs.mjs"
  },
